// ─────────────────────────────────────────────────────────────
// Schéma Prisma — CESIZen
// @map garde les noms de colonnes SQL en snake_case
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIF
  DESACTIVE
}

enum ContentStatus {
  BROUILLON
  PUBLIE
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(USER)
  statut       UserStatus @default(ACTIF)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  resetTokens  ResetToken[]
  contents     Content[]

  @@index([role])
  @@index([statut])
  @@map("users")
}

model ResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expireAt  DateTime  @map("expire_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expireAt])
  @@map("reset_tokens")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  contents  ContentCategory[]

  @@map("categories")
}

model Content {
  id        Int           @id @default(autoincrement())
  title     String        @db.VarChar(200)
  body      String        @db.Text
  status    ContentStatus @default(BROUILLON)
  authorId  Int?          @map("author_id")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  author    User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories ContentCategory[]

  @@index([status])
  @@index([authorId])
  @@map("contents")
}

model ContentCategory {
  contentId  Int @map("content_id")
  categoryId Int @map("category_id")

  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@map("contents_categories")
}

model BreathingPreset {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(10)
  inspirationS Int      @map("inspiration_s")
  apneeS       Int      @map("apnee_s")
  expirationS  Int      @map("expiration_s")
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("breathing_presets")
}
