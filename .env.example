# ─────────────────────────────────────────────────────
# CESIZen API — Variables d'environnement
# ─────────────────────────────────────────────────────

# Serveur
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL (Docker)
DB_USER=cesizen
DB_PASSWORD=cesizen_password
DB_NAME=cesizen

# URL Prisma (en LOCAL hors Docker : localhost / dans Docker : auto-injecté)
DATABASE_URL="postgresql://cesizen:cesizen_password@localhost:5432/cesizen?schema=public"

# JWT
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=1h

# Reset password
RESET_TOKEN_EXPIRES_MINUTES=30
RESET_PASSWORD_URL=exp://192.168.1.X:8081/--/reset-password

# Mail (Mailtrap)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
MAIL_FROM="CESIZen <no-reply@cesizen.fr>"
